      "icon": "🦙",
      "description": "Local LLM runtime",
      "healthCheck": true,
      "healthCheckPath": "/",
      "tags": ["llm", "api"],
      "pinned": false
    },
    {
      "id": "openwebui",
      "name": "Open WebUI",
      "url": "http://localhost:3000",
